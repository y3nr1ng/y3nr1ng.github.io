{% assign categories = include.projects | group_by: 'category' %}
<div class="portfolio-projects">
  {% for category in categories %}
    <section class="project-category" aria-label="{{ category.name }}">
      {% if include.index %}
        <h2 class="project-category-title">{{ category.name }}</h2>
      {% else %}
        <h3 class="project-category-title">{{ category.name }}</h3>
      {% endif %}
      <ul class="project-list">
        {% for project in category.items %}
          <li>
            <a class="project-title" href="{{ project.url | relative_url }}">{{ project.title }}</a>
            <p>{{ project.description }}</p>
            <p class="project-technologies">{{ project.technologies | join: ' · ' }}</p>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</div>
