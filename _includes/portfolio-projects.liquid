{% assign categories = include.projects | group_by: 'category' %}
{% assign discovered_names = categories | map: 'name' %}
{% assign category_names = site.data.portfolio_categories | concat: discovered_names | uniq %}
<div class="project-directory">
  <nav class="project-category-nav" aria-label="Project categories">
    <ul>
      {% for category_name in category_names %}
        {% assign category = categories | where: 'name', category_name | first %}
        {% if category %}
          <li>
            <a href="#category-{{ category.name | slugify }}">{{ category.name }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
  <div class="portfolio-projects">
    {% for category_name in category_names %}
      {% assign category = categories | where: 'name', category_name | first %}
      {% if category %}
        <section id="category-{{ category.name | slugify }}" class="project-category" aria-label="{{ category.name }}">
          {% if include.index %}
            <h2 class="project-category-title">{{ category.name }}</h2>
          {% else %}
            <h3 class="project-category-title">{{ category.name }}</h3>
          {% endif %}
          <ul class="project-list">
            {% for project in category.items %}
              <li>
                <div class="project-label{% if project.thumbnail %} project-label-with-thumbnail{% endif %}">
                  <div>
                    {% if project.url contains '://' %}
                      {% assign project_link = project.url %}
                    {% else %}
                      {% assign project_link = project.url | relative_url %}
                    {% endif %}
                    <a class="project-title" href="{{ project_link }}">{{ project.title }}</a>
                    {% if project.language or project.technology or project.course_label %}
                      <p class="project-meta">
                        {% if project.language -%}
                          <span class="project-language">{{ project.language | escape }}</span>
                        {%- endif %}
                        {% if project.language and project.technology %} · {% endif %}
                        {% if project.technology %}{{ project.technology | escape }}{% endif %}
                        {% if project.course_label %}
                          {% if project.language or project.technology %} · {% endif %}
                          <span class="project-course">{{ project.course_label | escape }}</span>
                        {% endif %}
                      </p>
                    {% endif %}
                  </div>
                  {% include portfolio-thumbnail.liquid thumbnail=project.thumbnail %}
                </div>
                <div class="project-summary">
                  <p>{{ project.description }}</p>
                  {% if project.resource %}
                    {% if project.resource.url contains '://' %}
                      {% assign resource_link = project.resource.url %}
                    {% else %}
                      {% assign resource_link = project.resource.url | relative_url %}
                    {% endif %}
                    <p class="project-resource">
                      <a href="{{ resource_link }}">{{ project.resource.label | escape }}</a>
                    </p>
                  {% endif %}
                  {% include project-publications.liquid publications=project.publications compact=true %}
                </div>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    {% endfor %}
  </div>
</div>
