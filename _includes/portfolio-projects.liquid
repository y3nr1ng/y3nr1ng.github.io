<div class="portfolio-projects">
  {% for project in include.projects %}
    <article class="portfolio-project">
      <div class="project-number" aria-hidden="true">
        {% if forloop.index < 10 %}0{% endif -%}
        {{- forloop.index }}
      </div>
      <div class="project-copy">
        <p class="eyebrow">{{ project.discipline }}</p>
        <h3>
          <a href="{{ project.url | relative_url }}">
            {{- project.title }}
            <span aria-hidden="true">↗</span></a
          >
        </h3>
        <p>{{ project.description }}</p>
        <ul class="project-tags" aria-label="Technologies">
          {% for technology in project.technologies %}
            <li>{{ technology }}</li>
          {% endfor %}
        </ul>
      </div>
      <a class="project-read" href="{{ project.url | relative_url }}"
        >Read project <span class="sr-only">{{ project.title }}</span><span aria-hidden="true">→</span></a
      >
    </article>
  {% endfor %}
</div>
