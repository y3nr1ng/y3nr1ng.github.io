<ul class="project-list system-list">
  {% for system in site.data.systems %}
    <li>
      <div class="system-label{% if system.thumbnail %} project-label-with-thumbnail{% endif %}">
        <div>
          <h3 class="system-title">
            {% if system.url %}
              <a href="{{ system.url | relative_url }}">{{ system.title | escape }}</a>
            {% else %}
              {{ system.title | escape }}
            {% endif %}
          </h3>
          <p class="system-meta">
            {% if system.institution %}{{ system.institution | escape }} · {% endif -%}
            {{- system.role | escape }}
          </p>
        </div>
        {% include portfolio-thumbnail.liquid thumbnail=system.thumbnail %}
      </div>
      <div class="project-summary">
        <p>{{ system.description | escape }}</p>
        {% if system.projects %}
          <p class="system-projects">
            Related software:
            {% for project in system.projects %}
              {% if project.url contains '://' %}
                {% assign project_link = project.url %}
              {% else %}
                {% assign project_link = project.url | relative_url %}
              {% endif %}
              <a href="{{ project_link }}">{{ project.title | escape }}</a>
              {%- unless forloop.last %}, {% endunless %}
            {% endfor %}
          </p>
        {% endif %}
        {% include project-publications.liquid publications=system.publications list=true %}
        {% if system.links %}
          <p class="system-projects">
            {% for link in system.links %}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- unless forloop.last %} · {% endunless %}
            {% endfor %}
          </p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
